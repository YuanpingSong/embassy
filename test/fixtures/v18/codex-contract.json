{
  "schemaVersion": 1,
  "normalization": {
    "canonicalJson": "Sort object keys recursively; preserve array order and every field.",
    "clock": "Use fixed ISO instants or relative T+Nms without changing event order.",
    "identity": "Map first occurrence by kind to $rpcN/$threadN/$turnN/$messageN/$endpointN/$pidN/$inodeN/$tmpN; equal inputs keep one token and distinct inputs stay distinct.",
    "privacy": "Synthetic bodies prove exact wire bytes but must not enter observations, errors, events, or retained goldens.",
    "writes": "Every scenario records semanticWrites: clean=0, armed uncertainty=1, and no replay keeps it at 1."
  },
  "contract": [
    { "id": "initialize", "classification": "HOLD", "reason": "Exact experimental capability, opt-outs, and initialized notification." },
    { "id": "resume-empty-history", "classification": "HOLD", "reason": "Exact thread, excludeTurns, empty history, and strict status." },
    { "id": "busy-approval", "classification": "HOLD", "reason": "Busy is pre-write and Embassy never answers approvals." },
    { "id": "start", "classification": "HOLD", "reason": "Exact turn/start text item and thread correlation." },
    { "id": "steer", "classification": "HOLD", "reason": "Exact active turn targeting without interruption." },
    { "id": "bounds", "classification": "HOLD", "reason": "Input, frame, reply, and operation bounds remain." },
    { "id": "consent-identity", "classification": "HOLD", "reason": "Authorization is bound to the exact attempt and prepared frame." },
    { "id": "provenance", "classification": "HOLD", "scope": "broker", "reason": "The broker-authored provenance envelope remains byte exact." },
    { "id": "queue-deadline-dedupe", "classification": "HOLD", "scope": "broker", "reason": "Broker queue, expiry, dedupe, and capacity semantics remain." },
    { "id": "exact-correlation", "classification": "HOLD", "reason": "Only the exact request, thread, turn, and attempt settle." },
    { "id": "fast-terminal", "classification": "HOLD", "reason": "A terminal may beat the start response without resurrection." },
    { "id": "first-terminal-wins", "classification": "HOLD", "reason": "Duplicate and late evidence cannot replace a terminal." },
    { "id": "no-replay-after-uncertainty", "classification": "HOLD", "reason": "An armed uncertain write is attempted exactly once." },
    { "id": "reply-bound-redaction", "classification": "HOLD", "reason": "Only a bounded exact final reply is exposed; raw data is redacted." },
    { "id": "cleanup-terminal-truth", "classification": "HOLD", "reason": "Cleanup failure cannot downgrade exact terminal truth." },
    { "id": "record-only-registration", "classification": "INTENTIONAL_CHANGE", "reason": "Registration persists identity without App Server I/O." },
    { "id": "connection-per-operation", "classification": "INTENTIONAL_CHANGE", "reason": "Every dispatch opens, initializes, resumes, and closes independently." },
    { "id": "registration-no-reachability", "classification": "INTENTIONAL_CHANGE", "reason": "Registration no longer certifies current provider reachability." },
    { "id": "desktop-independent-authority", "classification": "INTENTIONAL_CHANGE", "reason": "Desktop attachment is observation, never route authority." },
    { "id": "provider-unavailable-retains-route", "classification": "INTENTIONAL_CHANGE", "reason": "A clean unavailable result retains the durable route and mail." },
    { "id": "connector-health-observation-only", "classification": "INTENTIONAL_CHANGE", "reason": "Health is expiring observation, not write authority." },
    { "id": "loaded-list-admission", "classification": "DELETE", "reason": "Persistent loaded-thread admission disappears." },
    { "id": "endpoint-generation-authority", "classification": "DELETE", "reason": "Durable endpoint generations no longer authorize routing." },
    { "id": "refresh-reanchor-activation", "classification": "DELETE", "reason": "Refresh, re-anchor, re-arm, and activation ceremony disappears." },
    { "id": "connector-queue-recovery", "classification": "DELETE", "reason": "The broker alone owns queueing and recovery." },
    { "id": "unsubscribe-interrupt-cleanup", "classification": "DELETE", "reason": "Cleanup neither unsubscribes threads nor interrupts turns." },
    { "id": "stale-route-lifecycle", "classification": "DELETE", "reason": "Codex routes no longer have a durable stale lifecycle." },
    { "id": "setup-observation-rejection", "classification": "DELETE", "reason": "Registration-time setup observation cannot reject a route." },
    { "id": "succession-journals", "classification": "DELETE", "reason": "Generation succession journals and transitions disappear." },
    { "id": "reconnect-required-choreography", "classification": "DELETE", "reason": "Routine provider restart needs no reconnect dance." },
    { "id": "remove-stale-registration", "classification": "DELETE", "reason": "The stale-registration mutation has no remaining object." }
  ],
  "wireGolden": {
    "initialize": [{ "id": "$rpc1", "method": "initialize", "params": { "capabilities": { "experimentalApi": true, "optOutNotificationMethods": ["item/started", "item/agentMessage/delta", "item/reasoning/textDelta", "item/reasoning/summaryTextDelta", "item/commandExecution/outputDelta", "turn/diff/updated", "turn/plan/updated"] }, "clientInfo": { "name": "agent_embassy_gateway", "title": "Embassy Gateway", "version": "1.7.0" } } }, { "method": "initialized", "params": {} }],
    "resume": { "id": "$rpc2", "method": "thread/resume", "params": { "excludeTurns": true, "threadId": "$thread1" } },
    "start": { "id": "$rpc3", "method": "turn/start", "params": { "input": [{ "text": "$body1", "type": "text" }], "threadId": "$thread1" } },
    "steer": { "id": "$rpc3", "method": "turn/steer", "params": { "expectedTurnId": "$turn1", "input": [{ "text": "$body1", "type": "text" }], "threadId": "$thread1" } }
  },
  "golden": [
    { "id": "idle-start", "classification": "HOLD", "covers": ["initialize", "resume-empty-history", "start", "exact-correlation"], "expect": { "semanticWrites": 1, "outcome": "terminal-completed" } },
    { "id": "nonempty-history", "classification": "HOLD", "covers": ["resume-empty-history"], "expect": { "semanticWrites": 0, "outcome": "clean-failed" } },
    { "id": "busy", "classification": "HOLD", "covers": ["busy-approval"], "expect": { "semanticWrites": 0, "outcome": "clean-deferred" } },
    { "id": "approval", "classification": "HOLD", "covers": ["busy-approval"], "expect": { "semanticWrites": 0, "outcome": "clean-deferred" } },
    { "id": "bounds", "classification": "HOLD", "covers": ["bounds"], "expect": { "semanticWrites": 0, "outcome": "clean-failed-at-plus-one" } },
    { "id": "reply-bound", "classification": "HOLD", "covers": ["reply-bound-redaction"], "expect": { "semanticWrites": 1, "outcome": "terminal-completed", "replyCode": "REPLY_TOO_LARGE" } },
    { "id": "fast-terminal", "classification": "HOLD", "covers": ["fast-terminal", "first-terminal-wins"], "expect": { "semanticWrites": 1, "outcome": "terminal-completed" } },
    { "id": "prewrite-loss", "classification": "HOLD", "covers": ["no-replay-after-uncertainty"], "expect": { "semanticWrites": 0, "outcome": "clean-failed" } },
    { "id": "authorization-race", "classification": "HOLD", "covers": ["busy-approval", "consent-identity", "no-replay-after-uncertainty"], "expect": { "semanticWrites": 0, "outcome": "armed-ambiguous" } },
    { "id": "armed-start-loss", "classification": "HOLD", "covers": ["consent-identity", "no-replay-after-uncertainty"], "expect": { "semanticWrites": 1, "outcome": "armed-ambiguous" } },
    { "id": "armed-steer-loss", "classification": "HOLD", "covers": ["steer", "no-replay-after-uncertainty"], "expect": { "semanticWrites": 1, "outcome": "armed-ambiguous" } },
    { "id": "wrong-correlation", "classification": "HOLD", "covers": ["exact-correlation", "no-replay-after-uncertainty"], "expect": { "semanticWrites": 1, "outcome": "armed-ambiguous" } },
    { "id": "duplicate-terminal-cleanup", "classification": "HOLD", "covers": ["first-terminal-wins", "cleanup-terminal-truth"], "expect": { "semanticWrites": 1, "outcome": "terminal-completed", "cleanupConfirmed": false } }
  ]
}

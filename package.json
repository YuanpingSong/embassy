{
  "name": "claude-agent-mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "An unofficial, local-only MCP bridge for Claude Code CLI sessions and a neutral task lifecycle.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuanpingSong/claude-agent-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/YuanpingSong/claude-agent-bridge/issues"
  },
  "homepage": "https://github.com/YuanpingSong/claude-agent-bridge#readme",
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "multi-agent"
  ],
  "packageManager": "npm@10.9.8",
  "type": "module",
  "bin": {
    "claude-agent-mcp-bridge": "./dist/src/index.js",
    "claude-codex-gateway": "./dist/src/gateway/cli.js"
  },
  "files": [
    "dist/src",
    "skills/claude-codex-peer",
    "docs/GATEWAY-ARCHITECTURE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test",
    "demo": "tsx scripts/demo.ts",
    "gateway": "node dist/src/gateway/cli.js",
    "prevalidate:local": "npm run build",
    "prepack": "npm run build",
    "probe:codex-local": "tsx scripts/probe-codex-local.ts",
    "probe:codex-remote": "tsx scripts/probe-codex-remote.ts",
    "validate:local": "tsx scripts/validate-local.ts",
    "pretest": "npm run build",
    "start": "node dist/src/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
